#---Needs---
OPENROUTER_API_KEY=sk-or-v1-... # Openrouter API Key
GROQ_API_KEY=gsk_... # Groq API Key
GEMINI_API_KEY=... # Google AI Studio API key

#---Optional---
LIMIT=7 # Device limit
#PROVIDER= # Uncomment and set provider name (groq, gemini, openrouter, auto) for provider
#MODEL= # Uncomment and set model name to use (you must set PROVIDER variable to use it)
AI_PORT=5000 # Serving port
